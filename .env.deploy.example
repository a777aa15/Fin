# Скопируйте в .env рядом с docker-compose.yml на сервере и заполните.

# Пароль для PostgreSQL (придумайте свой)
POSTGRES_PASSWORD=

# Секрет сессий: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ИИ-наставник (Google Gemini)
GEMINI_API_KEY=
MENTOR_PROXY_URL=socks5://user:pass@host:port
MENTOR_MODEL=gemini-3.6-flash

# E-mail(ы) администраторов через запятую (авто-доступ + панель /admin)
ADMIN_EMAILS=

# SMTP для авто-писем (сброс пароля). Пример для Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com
#   SMTP_PASS=<пароль приложения Google>  SMTP_FROM=you@gmail.com
# Для Яндекса: SMTP_HOST=smtp.yandex.ru SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_URL=https://fincourse.duckdns.org
