# Скопируйте в .env.local и заполните.

# БД: пусто → PGlite (локально, ./.pglite-data). Прод: postgres://user:pass@host:5432/db
DATABASE_URL=

# Секрет для JWT-сессий (сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=

# ИИ-наставник (Google Gemini)
GEMINI_API_KEY=
MENTOR_PROXY_URL=socks5://user:pass@host:port
MENTOR_MODEL=gemini-3.6-flash
